    "wheel_speed_rr_kph": {"value": 0.0, "justification": "Stationary wheel baseline"},
    "battery_current_a": {"value": 0.0, "justification": "Balanced electrical load at equilibrium"},
    "battery_temp_c": {"value": 30.0, "justification": "Under-hood ambient thermal operating equilibrium"},
    "alternator_output_v": {"value": 14.1, "justification": "Standard 13.8V-14.4V alternator charging voltage"},
    "battery_charge_percent": {"value": 90.0, "justification": "Fully maintained float charge state"},
